<Window x:Class="parkin_ru1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая работа: Двумерные массивы и алгоритмы"
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#FF76E383">
            <TextBlock Text="Практическая работа — Вариант №4"
                       FontSize="22" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Frame для отображения страниц -->
        <Frame Grid.Row="1" Name="MainFrame"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>