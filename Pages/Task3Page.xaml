<Page x:Class="parkin_ru1.Pages.Task3Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 9.3">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontWeight="Bold" FontSize="14"
                   Margin="0,0,0,15"
                   Text="Задание 9.3. Дан целочисленный массив. Серия — группа подряд идущих одинаковых элементов. Вывести длины всех серий."/>

        <TextBlock Grid.Row="1" Text="Введите массив (числа через пробел):" Foreground="SeaGreen" Margin="0,5"/>
        <TextBox Grid.Row="2" Name="txtInputArray" Margin="0,0,0,10"/>

        <Button Grid.Row="3" Content="Выполнить" Width="140" Height="32"
                HorizontalAlignment="Left" Click="BtnExecute_Click"/>

        <TextBlock Grid.Row="4" Text="Результат:"  Foreground="SeaGreen" Margin="0,15,0,5"/>
        <TextBox Grid.Row="5" Name="txtResult" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <Button Grid.Row="6" Content="← Назад в меню" Width="140" Height="30"
                HorizontalAlignment="Left" Margin="0,10,0,0"
                Click="BtnBackToMenu_Click"/>
    </Grid>
</Page>