<Page x:Class="parkin_ru1.Pages.Task5Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 9.5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontWeight="Bold" FontSize="14"
                   Margin="0,0,0,15"
                   Text="Задание 9.5. Сгенерировать массив M столбцов × N строк (числа от -10 до 10). Отсортировать по возрастанию и убыванию. Найти max и min."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="M (столбцов):" Foreground="SeaGreen" VerticalAlignment="Center"/>
            <TextBox Name="txtColumnsCount" Width="50" Margin="5,0" Text="5" TextChanged="txtColumnsCount_TextChanged"/>
            <TextBlock Text="N (строк):" Foreground="SeaGreen" VerticalAlignment="Center"/>
            <TextBox Name="txtRowsCount" Width="50" Margin="5,0" Text="4"/>
            <Button Content="Сгенерировать и выполнить" Width="200" Height="32"
                    Margin="15,0,0,0" Click="BtnGenerateAndExecute_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Результат:" Foreground="SeaGreen" Margin="0,5,0,5"/>
        <TextBox Grid.Row="3" Name="txtResult" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13"/>

        <Button Grid.Row="4" Content="← Назад в меню"   Width="140" Height="30"
                HorizontalAlignment="Left" Margin="0,10,0,0"
                Click="BtnBackToMenu_Click"/>
    </Grid>
</Page>