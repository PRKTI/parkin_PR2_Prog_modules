<Page x:Class="parkin_ru1.Pages.Task4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 9.4">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontWeight="Bold" FontSize="14"
                   Margin="0,0,0,15"
                   Text="Задание 9.4. Поменять местами максимальный по модулю отрицательный элемент и минимальный положительный."/>

        <TextBlock Grid.Row="1" Text="Введите массив (числа через пробел):" Foreground="SeaGreen" Margin="0,5"/>
        <TextBox Grid.Row="2" Name="txtInputArray" Margin="0,0,0,10"
                 Text="4 5 6 7 -12 -3 4 -5 -7 2"/>

        <Button Grid.Row="3" Content="Выполнить" Width="140" Height="32"
                HorizontalAlignment="Left" Click="BtnExecute_Click"/>

        <TextBlock Grid.Row="4" Text="Результат:" Foreground="SeaGreen" Margin="0,15,0,5"/>
        <TextBox Grid.Row="5" Name="txtResult" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <Button Grid.Row="5" Content="← Назад в меню" Width="140" Height="30"
                HorizontalAlignment="Left" Margin="0,130,0,-30"
                Click="BtnBackToMenu_Click"/>
    </Grid>
</Page>